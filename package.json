{
  "name": "rega-facil",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "android": "adb reverse tcp:8081 tcp:8081 && expo start --localhost --android --port 8081",
    "android:native": "adb reverse tcp:8081 tcp:8081 && expo run:android",
    "android:emu": "adb reverse tcp:8081 tcp:8081 && set NODE_OPTIONS=--dns-result-order=ipv4first&& expo start --localhost --android --port 8081 --clear",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-notifications": "~0.32.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}

{
  "name": "rega-facil",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "android": "adb reverse tcp:8081 tcp:8081 && expo start --localhost --android --port 8081",
    "android:native": "adb reverse tcp:8081 tcp:8081 && expo run:android",
    "android:emu": "adb reverse tcp:8081 tcp:8081 && set NODE_OPTIONS=--dns-result-order=ipv4first&& expo start --localhost --android --port 8081 --clear",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "expo": "^57.0.0",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
